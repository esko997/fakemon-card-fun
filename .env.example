# Copy to .env and fill in. Only the OpenAI key is required.
# Either point at a file holding the key (keeps it out of the repo folder)...
OPENAI_API_KEY_FILE=~/.fakemon-card-fun-key
# ...or paste it directly:
# OPENAI_API_KEY=sk-...

# Shown on cards as the illustrator ("Illus. ...").
KID_NAME=Trainer

# New cards + "new picture" rerolls allowed per day (each one is an image generation).
# At 0 the kid sees "Ask Mom and Dad for more cards!"; grown-ups can add more for today.
DAILY_CARD_LIMIT=15
# PIN a grown-up types on the tablet (🔑) or the grown-ups page to add cards. Empty = no PIN,
# and the tablet shows no 🔑 button (top up from /parent.html instead).
PARENT_PIN=

# Stop generating once this month's estimated spend reaches this (USD).
# Also set a hard limit on the OpenAI project: platform.openai.com > Settings > Limits.
MONTHLY_BUDGET_USD=20

# Models. Each needs a rate in fakemon/pricing.py.
# gpt-image-2.5-sunburst: most faithful to the drawing. gpt-image-2.5-flare: same price, faster.
IMAGE_MODEL=gpt-image-2.5-sunburst
# low | medium | high | xhigh | max. Measured per regular card: medium ≈ $0.023, high ≈ $0.054,
# xhigh ≈ $0.086, max ≈ $0.18.
IMAGE_QUALITY=medium
TEXT_MODEL=gpt-6-luna
TRANSCRIBE_MODEL=gpt-transcribe
